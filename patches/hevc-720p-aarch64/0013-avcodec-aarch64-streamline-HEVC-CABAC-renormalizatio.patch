From c8ce289bac0f6969aceb2a6d1d4eebf3696553cd Mon Sep 17 00:00:00 2001
From: wanglimin40 <wanglimin40@huawei.com>
Date: Fri, 25 Sep 2026 02:48:44 +0800
Subject: [PATCH] avcodec/aarch64: streamline HEVC CABAC renormalization

---
 libavcodec/aarch64/cabac.h | 5 +++--
 libavcodec/hevc/cabac.c    | 3 +--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/libavcodec/aarch64/cabac.h b/libavcodec/aarch64/cabac.h
index 6b9b77e..4988c0d 100644
--- a/libavcodec/aarch64/cabac.h
+++ b/libavcodec/aarch64/cabac.h
@@ -48,15 +48,16 @@ static av_always_inline int get_cabac_inline_aarch64(CABACContext *c,
         "csel       %w[range]     , %w[r_c]     , %w[range], gt \n\t"
         "cinv       %w[bit]       , %w[bit]     , cc            \n\t"
         "sub        %w[low]       , %w[low]     , %w[tmp]       \n\t"
-        "add        %[r_b]        , %[tables]   , %[norm_off]   \n\t"
         "add        %[r_a]        , %[tables]   , %[mlps_off]   \n\t"
-        "ldrb       %w[tmp]       , [%[r_b], %w[range], SXTW]   \n\t"
+        "clz        %w[tmp]       , %w[range]                   \n\t"
+        "sub        %w[tmp]       , %w[tmp]     , #23           \n\t"
         "ldrb       %w[r_a]       , [%[r_a], %w[bit], SXTW]     \n\t"
         "lsl        %w[low]       , %w[low]     , %w[tmp]       \n\t"
         "lsl        %w[range]     , %w[range]   , %w[tmp]       \n\t"
         "uxth       %w[r_c]       , %w[low]                     \n\t"
         "strb       %w[r_a]       , [%[state]]                  \n\t"
         "cbnz       %w[r_c]       , 2f                          \n\t"
+        "add        %[r_b]        , %[tables]   , %[norm_off]   \n\t"
         "ldr        %[r_c]        , [%[c], %[byte]]             \n\t"
         "ldr        %[r_a]        , [%[c], %[end]]              \n\t"
         "ldrh       %w[tmp]       , [%[r_c]]                    \n\t"
diff --git a/libavcodec/hevc/cabac.c b/libavcodec/hevc/cabac.c
index 892dd1c..c5c5228 100644
--- a/libavcodec/hevc/cabac.c
+++ b/libavcodec/hevc/cabac.c
@@ -511,7 +511,7 @@ int ff_hevc_cabac_init(HEVCLocalContext *lc, const HEVCPPS *pps,
     return 0;
 }
 
-#define GET_CABAC(ctx)  get_cabac(&lc->cc, &lc->cabac_state[ctx])
+#define GET_CABAC(ctx)  get_cabac_inline(&lc->cc, &lc->cabac_state[ctx])
 
 int ff_hevc_sao_merge_flag_decode(HEVCLocalContext *lc)
 {
@@ -1512,4 +1512,3 @@ void ff_hevc_hls_mvd_coding(HEVCLocalContext *lc, int x0, int y0, int log2_cb_si
     case 0: lc->pu.mvd.y = 0;                       break;
     }
 }
-
-- 
2.43.0

