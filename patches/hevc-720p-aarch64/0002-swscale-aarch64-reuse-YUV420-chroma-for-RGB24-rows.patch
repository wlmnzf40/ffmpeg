From 1aa47bf5ee73bdf7c57ffda3271d7e746398b42f Mon Sep 17 00:00:00 2001
From: wanglimin40 <wanglimin40@huawei.com>
Date: Tue, 22 Sep 2026 11:02:22 +0800
Subject: [PATCH 2/4] swscale/aarch64: reuse YUV420 chroma for RGB24 rows

---
 libswscale/aarch64/yuv2rgb_neon.S | 75 ++++++++++++++++++++++++++++++-
 1 file changed, 74 insertions(+), 1 deletion(-)

diff --git a/libswscale/aarch64/yuv2rgb_neon.S b/libswscale/aarch64/yuv2rgb_neon.S
index 518f986..0c421e4 100644
--- a/libswscale/aarch64/yuv2rgb_neon.S
+++ b/libswscale/aarch64/yuv2rgb_neon.S
@@ -271,4 +271,77 @@ declare_rgb_funcs nv12
 declare_rgb_funcs nv21
 declare_rgb_funcs yuv420p
 declare_rgb_funcs yuv422p
-declare_func yuv420p, rgb24
+function ff_yuv420p_to_rgb24_neon, export=1
+        load_args_yuv420p rgb24
+        mov             w9, w1
+1:
+        add             w17, w5, w0                                    // linesizeY
+        add             x10, x4, w17, sxtw                             // second luma line
+        add             w17, w3, w0
+        add             w17, w17, w0, lsl #1                           // destination linesize
+        add             x12, x2, w17, sxtw                             // second destination line
+        mov             w8, w0                                         // remaining width
+2:
+        movi            v5.8h, #4, lsl #8                              // 128 * (1<<3)
+        load_chroma_yuv420p
+        sub             v18.8h, v18.8h, v5.8h                          // U*(1<<3) - 128*(1<<3)
+        sub             v19.8h, v19.8h, v5.8h                          // V*(1<<3) - 128*(1<<3)
+        sqdmulh         v20.8h, v19.8h, v1.h[0]                        // V * v2r
+        sqdmulh         v22.8h, v18.8h, v1.h[1]                        // U * u2g
+        sqdmulh         v19.8h, v19.8h, v1.h[2]                        // V * v2g
+        add             v22.8h, v22.8h, v19.8h                         // U * u2g + V * v2g
+        sqdmulh         v24.8h, v18.8h, v1.h[3]                        // U * u2b
+        zip2            v21.8h, v20.8h, v20.8h                         // R high pixels
+        zip1            v20.8h, v20.8h, v20.8h                         // R low pixels
+        zip2            v23.8h, v22.8h, v22.8h                         // G high pixels
+        zip1            v22.8h, v22.8h, v22.8h                         // G low pixels
+        zip2            v25.8h, v24.8h, v24.8h                         // B high pixels
+        zip1            v24.8h, v24.8h, v24.8h                         // B low pixels
+
+        // Preserve chroma contributions for the second luma line.
+        mov             v28.16b, v20.16b
+        mov             v29.16b, v21.16b
+        mov             v30.16b, v22.16b
+        mov             v31.16b, v23.16b
+        mov             v7.16b,  v24.16b
+        mov             v15.16b, v25.16b
+
+        ld1             {v2.16b}, [x4], #16
+        ushll           v26.8h, v2.8b,  #3
+        ushll2          v27.8h, v2.16b, #3
+        sub             v26.8h, v26.8h, v3.8h
+        sub             v27.8h, v27.8h, v3.8h
+        sqdmulh         v26.8h, v26.8h, v0.8h
+        sqdmulh         v27.8h, v27.8h, v0.8h
+        compute_rgb     v4.8b,v5.8b,v6.8b, v16.8b,v17.8b,v18.8b
+        st3             { v4.8b, v5.8b, v6.8b }, [x2], #24
+        st3             {v16.8b,v17.8b,v18.8b }, [x2], #24
+
+        mov             v20.16b, v28.16b
+        mov             v21.16b, v29.16b
+        mov             v22.16b, v30.16b
+        mov             v23.16b, v31.16b
+        mov             v24.16b, v7.16b
+        mov             v25.16b, v15.16b
+        ld1             {v2.16b}, [x10], #16
+        ushll           v26.8h, v2.8b,  #3
+        ushll2          v27.8h, v2.16b, #3
+        sub             v26.8h, v26.8h, v3.8h
+        sub             v27.8h, v27.8h, v3.8h
+        sqdmulh         v26.8h, v26.8h, v0.8h
+        sqdmulh         v27.8h, v27.8h, v0.8h
+        compute_rgb     v4.8b,v5.8b,v6.8b, v16.8b,v17.8b,v18.8b
+        st3             { v4.8b, v5.8b, v6.8b }, [x12], #24
+        st3             {v16.8b,v17.8b,v18.8b }, [x12], #24
+
+        subs            w8, w8, #16
+        b.gt            2b
+        add             x2, x12, w3, sxtw                             // skip destination padding
+        add             x4, x10, w5, sxtw                             // skip luma padding
+        add             x6, x6, w7, sxtw                              // skip U padding
+        add             x13, x13, w14, sxtw                           // skip V padding
+        subs            w1, w1, #2
+        b.gt            1b
+        mov             w0, w9
+    ret
+endfunc
