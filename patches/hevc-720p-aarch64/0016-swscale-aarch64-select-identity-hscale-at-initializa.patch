From 76321fecd3bb0fa68827012d451a430bb580f96c Mon Sep 17 00:00:00 2001
From: wanglimin40 <wanglimin40@huawei.com>
Date: Fri, 25 Sep 2026 13:40:45 +0800
Subject: [PATCH] swscale/aarch64: select identity hscale at initialization

---
 libswscale/aarch64/swscale.c | 49 ++++++++++++++++++++++++++----------
 1 file changed, 36 insertions(+), 13 deletions(-)

diff --git a/libswscale/aarch64/swscale.c b/libswscale/aarch64/swscale.c
index c3986ce19..d7d848dc0 100644
--- a/libswscale/aarch64/swscale.c
+++ b/libswscale/aarch64/swscale.c
@@ -62,8 +62,29 @@ static av_always_inline int is_hscale16_identity(int shift, int dstW,
              filter[last * 4 + 2]);
 }
 
-static void hscale16to15_identity_neon(int16_t *dst, int dstW,
-                                       const uint8_t *srcBytes)
+static av_always_inline int hscale16to15_shift(const SwsContext *c)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(c->srcFormat);
+    int shift = desc->comp[0].depth - 1;
+
+    if (shift < 15) {
+        const int isRgb = (desc->flags & AV_PIX_FMT_FLAG_RGB) ||
+                          c->srcFormat == AV_PIX_FMT_MONOBLACK ||
+                          c->srcFormat == AV_PIX_FMT_MONOWHITE;
+
+        shift = isRgb || c->srcFormat == AV_PIX_FMT_PAL8 ?
+                13 : desc->comp[0].depth - 1;
+    } else if (desc->flags & AV_PIX_FMT_FLAG_FLOAT) {
+        shift = 15;
+    }
+    return shift;
+}
+
+static void hscale16to15_identity_neon(SwsContext *c, int16_t *dst, int dstW,
+                                       const uint8_t *srcBytes,
+                                       const int16_t *filter,
+                                       const int32_t *filterPos,
+                                       int filterSize)
 {
     const uint16_t *src = (const uint16_t *)srcBytes;
     int x = 0;
@@ -82,18 +103,8 @@ static void ff_hscale16to15_4_neon(SwsContext *c, int16_t *_dst, int dstW,
                       const uint8_t *_src, const int16_t *filter,
                       const int32_t *filterPos, int filterSize)
 {
-    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(c->srcFormat);
-    int sh              = desc->comp[0].depth - 1;
+    int sh = hscale16to15_shift(c);
 
-    if (sh<15) {
-        sh = isAnyRGB(c->srcFormat) || c->srcFormat==AV_PIX_FMT_PAL8 ? 13 : (desc->comp[0].depth - 1);
-    } else if (desc->flags & AV_PIX_FMT_FLAG_FLOAT) { /* float input are process like uint 16bpc */
-        sh = 16 - 1;
-    }
-    if (is_hscale16_identity(sh, dstW, filter, filterPos, filterSize)) {
-        hscale16to15_identity_neon(_dst, dstW, _src);
-        return;
-    }
     ff_hscale16to15_4_neon_asm(sh, _dst, dstW, _src, filter, filterPos, filterSize);
 
 }
@@ -286,6 +297,18 @@ av_cold void ff_sws_init_swscale_aarch64(SwsContext *c)
     if (have_neon(cpu_flags)) {
         ASSIGN_SCALE_FUNC(c->hyScale, c->hLumFilterSize, neon);
         ASSIGN_SCALE_FUNC(c->hcScale, c->hChrFilterSize, neon);
+        if (c->srcBpc != 8 && c->dstBpc <= 14) {
+            const int shift = hscale16to15_shift(c);
+
+            if (is_hscale16_identity(shift, c->dstW, c->hLumFilter,
+                                     c->hLumFilterPos, c->hLumFilterSize)) {
+                c->hyScale = hscale16to15_identity_neon;
+            }
+            if (is_hscale16_identity(shift, c->chrDstW, c->hChrFilter,
+                                     c->hChrFilterPos, c->hChrFilterSize)) {
+                c->hcScale = hscale16to15_identity_neon;
+            }
+        }
         ASSIGN_VSCALE_FUNC(c->yuv2plane1, neon);
         if (c->dstBpc == 8) {
             c->yuv2planeX = ff_yuv2planeX_8_neon;
-- 
2.43.0

