From 7372037fc6fd8f086bfd4fff45249ceccdb7c9c0 Mon Sep 17 00:00:00 2001
From: wanglimin40 <wanglimin40@huawei.com>
Date: Sat, 26 Sep 2026 02:25:47 +0800
Subject: [PATCH 22/23] avcodec/hevc: batch CABAC bypass bins for coefficient
 decoding

---
 .../22-hevc-cabac-bypass-batching.md          | 36 +++++++
 libavcodec/hevc/cabac.c                       | 96 +++++++++++++++++--
 2 files changed, 125 insertions(+), 7 deletions(-)
 create mode 100644 docs/optimizations/hevc-720p-aarch64/22-hevc-cabac-bypass-batching.md

diff --git a/docs/optimizations/hevc-720p-aarch64/22-hevc-cabac-bypass-batching.md b/docs/optimizations/hevc-720p-aarch64/22-hevc-cabac-bypass-batching.md
new file mode 100644
index 000000000..0cf002e8b
--- /dev/null
+++ b/docs/optimizations/hevc-720p-aarch64/22-hevc-cabac-bypass-batching.md
@@ -0,0 +1,36 @@
+# 优化点 22：HEVC CABAC 旁路位批量读取
+
+## 代码走读
+
+系数幅值、符号等语法元素包含连续的 CABAC bypass 位。旧实现对每一位
+调用一次 `get_cabac_bypass`，重复进行范围比较和状态更新。
+`cabac_bypass_bits` 把连续位的解码视为同一归一化区间中的商：
+输入偏移左移 `n` 位，除以编码区间 `range << (CABAC_BITS + 1)` 得到
+`n` 位结果，余数更新解码状态。若输入跨过补充字节边界，先补入字节；
+若无法安全走批量路径，则回退到原来的逐位读取。
+
+`cabac_unary_prefix` 同理批量查找一串前导 1，遇到第一个 0 时调整
+解码状态和消费位数。系数绝对值余数和长度大于 2 的符号位使用这些函数；
+短序列仍使用旧路径。此改动适用于相同语法规则的输入，不依赖视频内容
+特征，也不改变线程数。
+
+## 验证
+
+本优化单独叠加在优化点 21 之后，两版使用相同鲲鹏 920、GCC 静态构建、
+输入和 `-threads 0`。完整命令：
+
+```bash
+ffmpeg -nostdin -v fatal -threads 0 \
+    -i /data/wanglimin/HEVC-720p-10min.mov \
+    -frames:v 15000 -an -sn -vf format=rgb24 -f null -
+```
+
+| 交叉顺序 | 优化点 21 后 `real` | 再加本优化 `real` |
+|---|---:|---:|
+| 对照 → 本优化 | 29.859 s | 29.892 s |
+| 本优化 → 对照 | 30.103 s | 29.326 s |
+
+均值约下降 0.372 秒（1.24%），但第一对略慢，收益幅度有波动。
+3000 帧 RGB24 `framemd5` 管道 SHA-256 与对照一致：
+`9bf7a192699267ddfb6615887231209758dcdc695aa740c6ca75cb5f4709f792`。
+不把该收益直接外推到其他输入；20 秒目标尚未达到。
diff --git a/libavcodec/hevc/cabac.c b/libavcodec/hevc/cabac.c
index 12a105cf5..ec32c475c 100644
--- a/libavcodec/hevc/cabac.c
+++ b/libavcodec/hevc/cabac.c
@@ -990,30 +990,109 @@ static av_always_inline int coeff_abs_level_greater2_flag_decode(HEVCLocalContex
     return GET_CABAC(COEFF_ABS_LEVEL_GREATER2_FLAG_OFFSET + inc);
 }
 
-static av_always_inline int coeff_abs_level_remaining_decode(HEVCLocalContext *lc, int rc_rice_param)
+/* A run of bypass bins is the quotient of the offset by range << 17. */
+static int cabac_bypass_bits(CABACContext *c, int n)
+{
+    int avail = CABAC_BITS - ff_ctz(c->low);
+    uint64_t x;
+    uint64_t r = (uint64_t)c->range << (CABAC_BITS + 1);
+    const uint8_t *bytestream = c->bytestream;
+
+    if (n < avail) {
+        x = (uint64_t)c->low << n;
+    } else {
+        int fill = (bytestream[0] << 9) + (bytestream[1] << 1) - CABAC_MASK;
+
+        x = (uint64_t)(((int64_t)c->low << avail) + fill) << (n - avail);
+#if !UNCHECKED_BITSTREAM_READER
+        if (bytestream < c->bytestream_end)
+#endif
+            bytestream += CABAC_BITS / 8;
+    }
+
+    if (x < r << n) {
+        c->low = x % r;
+        c->bytestream = bytestream;
+        return x / r;
+    } else {
+        int ret = 0;
+
+        for (int i = 0; i < n; i++)
+            ret = (ret << 1) | get_cabac_bypass(c);
+        return ret;
+    }
+}
+
+/* Leading ones of the quotient, consumed only up to the first zero. */
+static int cabac_unary_prefix(CABACContext *c, int max)
 {
     int prefix = 0;
+
+    while (prefix < max) {
+        int avail = CABAC_BITS - ff_ctz(c->low);
+        int n = FFMIN(avail - 1, max - prefix);
+        uint64_t r = (uint64_t)c->range << (CABAC_BITS + 1);
+        uint64_t x = (uint64_t)c->low << n;
+        int q;
+        int t;
+
+        if (n < 1 || x >= r << n) {
+            if (!get_cabac_bypass(c))
+                return prefix;
+            prefix++;
+            continue;
+        }
+
+        q = x / r;
+        t = ~q & ((1 << n) - 1);
+        if (t) {
+            int p = n - 1 - av_log2(t);
+            int k = n - (p + 1);
+
+            c->low = (x >> k) - ((uint64_t)(q >> k) * r);
+            return prefix + p;
+        }
+        c->low = x - (uint64_t)q * r;
+        prefix += n;
+    }
+    return prefix;
+}
+
+static av_always_inline int coeff_abs_level_remaining_decode(HEVCLocalContext *lc, int rc_rice_param)
+{
+    int prefix;
     int suffix = 0;
     int last_coeff_abs_level_remaining;
     int i;
 
-    while (prefix < CABAC_MAX_BIN && get_cabac_bypass(&lc->cc))
-        prefix++;
+    prefix = cabac_unary_prefix(&lc->cc, CABAC_MAX_BIN);
 
     if (prefix < 3) {
-        for (i = 0; i < rc_rice_param; i++)
-            suffix = (suffix << 1) | get_cabac_bypass(&lc->cc);
+        if (rc_rice_param > 2)
+            suffix = cabac_bypass_bits(&lc->cc, rc_rice_param);
+        else
+            for (i = 0; i < rc_rice_param; i++)
+                suffix = (suffix << 1) | get_cabac_bypass(&lc->cc);
         last_coeff_abs_level_remaining = (prefix << rc_rice_param) + suffix;
     } else {
         int prefix_minus3 = prefix - 3;
+        int k;
 
         if (prefix == CABAC_MAX_BIN || prefix_minus3 + rc_rice_param > 16 + 6) {
             av_log(lc->logctx, AV_LOG_ERROR, "CABAC_MAX_BIN : %d\n", prefix);
             return 0;
         }
 
-        for (i = 0; i < prefix_minus3 + rc_rice_param; i++)
-            suffix = (suffix << 1) | get_cabac_bypass(&lc->cc);
+        k = prefix_minus3 + rc_rice_param;
+        if (k > 16) {
+            suffix  = cabac_bypass_bits(&lc->cc, 16) << (k - 16);
+            suffix |= cabac_bypass_bits(&lc->cc, k - 16);
+        } else if (k > 2) {
+            suffix = cabac_bypass_bits(&lc->cc, k);
+        } else {
+            for (i = 0; i < k; i++)
+                suffix = (suffix << 1) | get_cabac_bypass(&lc->cc);
+        }
         last_coeff_abs_level_remaining = (((1 << prefix_minus3) + 3 - 1)
                                               << rc_rice_param) + suffix;
     }
@@ -1025,6 +1104,9 @@ static av_always_inline int coeff_sign_flag_decode(HEVCLocalContext *lc, uint8_t
     int i;
     int ret = 0;
 
+    if (nb > 2)
+        return cabac_bypass_bits(&lc->cc, nb);
+
     for (i = 0; i < nb; i++)
         ret = (ret << 1) | get_cabac_bypass(&lc->cc);
     return ret;
-- 
